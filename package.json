{
  "name": "startup-nextjs-template",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --no-warnings --experimental-strip-types --test src/lib/occasionSearch.test.ts",
    "test:backend": "vitest run --config vitest.backend.config.ts --configLoader runner",
    "test:contract": "truffle test --config truffle-config.js --network test",
    "test:all": "npm run test && npm run test:backend && npm run test:ui && npm run test:contract",
    "lint": "next lint",
    "bx:compile": "truffle compile",
    "bx:start": "ganache-cli",
    "test:ui": "vitest run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:inspect": "node scripts/prisma-inspect.mjs"
  },
  "dependencies": {
    "@next-auth/mongodb-adapter": "^1.1.3",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.1.6",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "ganache-cli": "^6.12.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "next": "15.1.6",
    "next-auth": "^4.24.11",
    "next-themes": "^0.2.1",
    "openai": "^4.86.1",
    "react": "19.0.0",
    "react-country-state-city": "^1.1.11",
    "react-dom": "19.0.0",
    "react-modal-video": "^2.0.1",
    "truffle": "^5.11.5",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.8.9",
    "@types/react": "19.0.8",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  }
}
